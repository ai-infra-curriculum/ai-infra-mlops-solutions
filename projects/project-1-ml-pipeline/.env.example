# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=churn_prediction
POSTGRES_USER=mlops_user
POSTGRES_PASSWORD=changeme

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=churn-prediction
MLFLOW_ARTIFACT_LOCATION=s3://mlflow-artifacts
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CUSTOMER_EVENTS=customer-events
KAFKA_CONSUMER_GROUP=churn-prediction

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
API_KEY=your-api-key-here
API_RATE_LIMIT=1000

# Model Configuration
MODEL_NAME=churn-predictor
MODEL_STAGE=Production
MODEL_VERSION=latest
PREDICTION_THRESHOLD=0.5

# Feature Store Configuration
FEATURE_STORE_TYPE=postgresql
FEATURE_TTL_SECONDS=86400

# Monitoring Configuration
PROMETHEUS_PORT=9090
DRIFT_CHECK_INTERVAL_MINUTES=15
DRIFT_THRESHOLD_PSI=0.2
DRIFT_THRESHOLD_KS=0.05

# Airflow Configuration
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=your-secret-key-here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
DEBUG=true
